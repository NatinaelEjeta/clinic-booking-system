# ---------------------------------------------------------------------------
# CarePoint Clinic — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Database connection string.
# Local development (SQLite, file path is relative to prisma/schema.prisma):
DATABASE_URL="file:../db/custom.db"
# Production (Neon PostgreSQL — also change provider to "postgresql" in
# prisma/schema.prisma, then run `npx prisma db push`):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Secret used to sign the JWT session cookie. Minimum 16 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"

# IANA timezone used for ALL scheduling math and display (slots, calendars).
# The database always stores UTC; this is the clinic's wall-clock timezone.
CLINIC_TIMEZONE="Africa/Addis_Ababa"

# Shared secret required by GET /api/cron/reminders
# (sent automatically as "Authorization: Bearer <CRON_SECRET>" by Vercel Cron).
CRON_SECRET="change-me-cron-secret"

# Optional — Resend API key for transactional emails.
# When empty, emails are logged to the server console instead of being sent,
# so the app is fully functional without any email provider.
RESEND_API_KEY=""

# Optional — verified sender identity for Resend.
EMAIL_FROM="CarePoint Clinic <bookings@yourdomain.com>"
